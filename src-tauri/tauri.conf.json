{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DistroVault",
  "version": "0.1.2",
  "identifier": "io.github.distrovault.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DistroVault",
        "width": 1200,
        "height": 800,
        "minWidth": 770,
        "minHeight": 550,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
